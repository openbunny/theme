{
  "name": "@openbunny/theme",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./tokens": {
      "types": "./packages/web/dist/tokens.d.ts",
      "default": "./packages/web/dist/tokens.js"
    },
    "./contrast": {
      "types": "./packages/web/dist/contrast.d.ts",
      "default": "./packages/web/dist/contrast.js"
    },
    "./css/*.css": "./packages/web/css/*.css",
    "./fonts/*": "./packages/web/fonts/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "24.19.2",
    "knip": "6.45.1",
    "prettier": "3.10.1",
    "style-dictionary": "5.8.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
